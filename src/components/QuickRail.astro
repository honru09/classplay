---
import { u } from '../lib/games.mjs';
---

<aside id="quickRail" class="quick-rail" aria-label="Quick navigation">
  <div class="qr-pill" id="qrPill">
    <!-- Peek tab indicator (visible only in peek mode on game pages) -->
    <div class="qr-peek-tab" aria-hidden="true" title="Recent games">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
        <path d="M13 3a9 9 0 0 0-9 9H1l3.89 3.89.07.14L9 12H6c0-3.87 3.13-7 7-7s7 3.13 7 7-3.13 7-7 7c-1.93 0-3.68-.79-4.94-2.06l-1.42 1.42A8.954 8.954 0 0 0 13 21a9 9 0 0 0 0-18zm-1 5v5l4.28 2.54.72-1.21-3.5-2.08V8H12z" />
      </svg>
    </div>

    <button
      type="button"
      class="qr-btn"
      id="qrBtnPopular"
      data-action="popular"
      title="Popular games"
      aria-label="Popular games"
    >
      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
        <path d="M11.5 1.25a.75.75 0 0 1 1.05.2c.2.28 1.8 2.57 2.1 4.55.15 1.03-.05 1.95-.45 2.75 1.62-.87 2.5-2.32 2.7-3.65a.75.75 0 0 1 1.3-.35C19.7 6.4 21 9.2 21 12.25 21 17.5 16.75 22 11.5 22 6.5 22 2.5 18 2.5 13c0-3.6 1.9-6.8 4.7-8.6a.75.75 0 0 1 1.15.55c.1 1.2.6 2.2 1.3 3 .3-1.6 1.1-4.8 1.85-6.7zM11.5 12c-1.38 0-2.5 1.12-2.5 2.5 0 1.28.97 2.33 2.22 2.48.1.01.19.02.28.02 1.38 0 2.5-1.12 2.5-2.5 0-1.02-.61-1.9-1.48-2.28-.31-.14-.66-.22-1.02-.22z" />
      </svg>
      <span class="qr-label">Popular</span>
    </button>
    <button
      type="button"
      class="qr-btn"
      id="qrBtnNew"
      data-action="new"
      data-href={u('#new')}
      title="More games"
      aria-label="More games"
    >
      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
        <path d="M12 2l2.4 5.6L20 10l-5.6 2.4L12 18l-2.4-5.6L4 10l5.6-2.4L12 2zm7 13l1.2 2.8L23 19l-2.8 1.2L19 23l-1.2-2.8L15 19l2.8-1.2L19 15zm-14 0l1.2 2.8L9 19l-2.8 1.2L5 23l-1.2-2.8L1 19l2.8-1.2L5 15z" />
      </svg>
      <span class="qr-label">More</span>
    </button>
    <a
      href={u('all-games/')}
      class="qr-btn"
      id="qrBtnCategories"
      data-action="categories"
      title="All games"
      aria-label="Games"
    >
      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" clip-rule="evenodd" d="M7 5h10a5 5 0 0 1 4.9 6l-1.4 6.7A2.5 2.5 0 0 1 18.1 20H17a3 3 0 0 1-2.8-2l-.7-2H10.5l-.7 2A3 3 0 0 1 7 20H5.9a2.5 2.5 0 0 1-2.4-2.3L2.1 11A5 5 0 0 1 7 5zm-1 5.5a.75.75 0 0 1 .75-.75h1v-1a.75.75 0 0 1 1.5 0v1h1a.75.75 0 0 1 0 1.5h-1v1a.75.75 0 0 1-1.5 0v-1h-1A.75.75 0 0 1 6 10.5zm10.25 1.75a1.25 1.25 0 1 0 0-2.5 1.25 1.25 0 0 0 0 2.5zm2-2.5a1.25 1.25 0 1 0 0-2.5 1.25 1.25 0 0 0 0 2.5z" />
      </svg>
      <span class="qr-label">Games</span>
    </a>
    <button
      type="button"
      class="qr-btn"
      id="qrBtnSearch"
      data-action="search"
      title="Search games"
      aria-label="Search games"
    >
      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
        <path d="M15.5 14h-.79l-.28-.27A6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" />
      </svg>
      <span class="qr-label">Search</span>
    </button>
    <button
      type="button"
      class="qr-btn"
      id="qrBtnRecent"
      data-action="recent"
      title="Recently played"
      aria-label="Recently played games"
    >
      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
        <path d="M13 3a9 9 0 0 0-9 9H1l3.89 3.89.07.14L9 12H6c0-3.87 3.13-7 7-7s7 3.13 7 7-3.13 7-7 7c-1.93 0-3.68-.79-4.94-2.06l-1.42 1.42A8.954 8.954 0 0 0 13 21a9 9 0 0 0 0-18zm-1 5v5l4.28 2.54.72-1.21-3.5-2.08V8H12z" />
      </svg>
      <span class="qr-label">Recent</span>
    </button>
  </div>
</aside>

<style>
  .quick-rail {
    position: fixed;
    z-index: 45;
    right: 12px;
    top: 45%;
    transform: translateY(-50%);
    pointer-events: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.22s ease, width 0.22s ease, opacity 0.2s ease;
  }
  @media (max-width: 640px) {
    .quick-rail {
      right: 6px;
    }
  }
  .qr-pill {
    pointer-events: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    padding: 5px 4px;
    background: #ffffff;
    border-radius: 999px;
    box-shadow: 0 4px 18px rgba(23, 35, 63, 0.2), 0 1px 3px rgba(23, 35, 63, 0.1);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    -webkit-tap-highlight-color: transparent;
  }
  .qr-btn {
    min-width: 44px;
    min-height: 44px;
    height: 46px;
    border-radius: 12px;
    border: 0;
    background: transparent;
    color: #17233f;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    cursor: pointer;
    padding: 3px 6px;
    box-sizing: border-box;
    transition: background 0.14s ease, color 0.14s ease, transform 0.1s ease;
    text-decoration: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    -webkit-tap-highlight-color: transparent;
  }
  .qr-btn svg {
    width: 18px;
    height: 18px;
    pointer-events: none;
    flex-shrink: 0;
  }
  .qr-btn .qr-label {
    font-size: 9.5px;
    line-height: 1.1;
    font-weight: 700;
    letter-spacing: -0.2px;
    color: inherit;
    pointer-events: none;
  }
  .qr-btn:hover {
    background: #e6f7ff;
    color: #0369a1;
    text-decoration: none;
  }
  .qr-btn:active {
    transform: scale(0.92);
  }
  .qr-btn:focus-visible {
    outline: 2px solid var(--cyan, #0369a1);
    outline-offset: 2px;
  }
  /* Active-section accent fill (ClassPlay accent) */
  .qr-btn.is-active {
    background: var(--cyan, #0369a1) !important;
    color: #ffffff !important;
    font-weight: 900;
  }

  /* Peek tab indicator */
  .qr-peek-tab {
    display: none;
  }

  /* Game pages peek tab (~26px wide with clock icon visible in it) */
  .quick-rail.is-peek {
    width: 26px !important;
    min-width: 26px !important;
    max-width: 26px !important;
    right: 0 !important;
    left: auto !important;
    top: 45% !important;
    bottom: auto !important;
    transform: translateY(-50%) !important;
    pointer-events: auto !important;
    cursor: pointer;
    overflow: hidden !important;
    z-index: 45;
  }
  .quick-rail.is-peek .qr-pill {
    width: 26px !important;
    min-width: 26px !important;
    max-width: 26px !important;
    padding: 12px 0 !important;
    border-radius: 10px 0 0 10px !important;
    overflow: hidden !important;
    background: #ffffff;
    box-shadow: -2px 0 10px rgba(23, 35, 63, 0.25);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0 !important;
  }
  .quick-rail.is-peek .qr-btn {
    display: none !important;
  }
  .quick-rail.is-peek .qr-peek-tab {
    display: flex !important;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 32px;
    color: #17233f;
  }
  .quick-rail.is-peek .qr-peek-tab svg {
    display: block;
    width: 16px;
    height: 16px;
  }

  @media (prefers-reduced-motion: reduce) {
    .quick-rail, .qr-pill, .qr-btn {
      transition: none !important;
    }
  }
</style>

<script>
  (() => {
    const rail = document.getElementById('quickRail');
    const pill = document.getElementById('qrPill');
    if (!rail || !pill) return;

    // Delete legacy position key for returning users
    try {
      localStorage.removeItem(['qr', 'pos'].join('-'));
    } catch (e) {}

    const playerFrame = document.getElementById('playerFrame');
    const isGamePage = !!playerFrame;

    let isPlayerIntersecting = false;
    let isPeekExpanded = false;
    let peekTimer: any = null;

    const collapseToPeek = () => {
      if (!isGamePage || isPeekExpanded) return;
      rail.classList.add('is-peek');
    };

    const restoreFromPeek = () => {
      rail.classList.remove('is-peek');
    };

    const expandPeekTemporarily = () => {
      if (!rail.classList.contains('is-peek')) return;
      restoreFromPeek();
      isPeekExpanded = true;
      if (peekTimer) clearTimeout(peekTimer);
      peekTimer = setTimeout(() => {
        isPeekExpanded = false;
        if (isPlayerIntersecting) {
          collapseToPeek();
        }
      }, 3000);
    };

    if (isGamePage && playerFrame) {
      const io = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          isPlayerIntersecting = entry.isIntersecting;
          if (isPlayerIntersecting) {
            collapseToPeek();
          } else {
            restoreFromPeek();
          }
        }
      }, { threshold: 0 });
      io.observe(playerFrame);

      const r = playerFrame.getBoundingClientRect();
      if (r.bottom > 0 && r.top < window.innerHeight) {
        isPlayerIntersecting = true;
        collapseToPeek();
      }
    }

    // Tap on peek tab to expand for 3s
    rail.addEventListener('click', (e) => {
      if (rail.classList.contains('is-peek')) {
        e.preventDefault();
        e.stopPropagation();
        expandPeekTemporarily();
      }
    });

    // Button actions
    pill.querySelectorAll('.qr-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        if (rail.classList.contains('is-peek')) {
          e.preventDefault();
          e.stopPropagation();
          return;
        }

        const action = (btn as HTMLElement).dataset.action;
        if (action === 'popular') {
          e.preventDefault();
          const target = document.getElementById('popular');
          if (target) {
            target.scrollIntoView({ behavior: 'smooth' });
          } else {
            window.location.href = `${(btn.getAttribute('href') || '/')}#popular`;
          }
        } else if (action === 'new') {
          e.preventDefault();
          const target = document.getElementById('new');
          if (target) {
            target.scrollIntoView({ behavior: 'smooth' });
          } else {
            window.location.href = (btn as HTMLElement).dataset.href || '/#new';
          }
        } else if (action === 'search') {
          e.preventDefault();
          if (typeof (window as any).togglePokiSearch === 'function') {
            (window as any).togglePokiSearch();
          }
        } else if (action === 'recent') {
          e.preventDefault();
          const railEl = document.getElementById('jumpBackInRail');
          const hasRecents = railEl && railEl.querySelector('.shelf, .tiles, a');
          if (hasRecents) {
            railEl.scrollIntoView({ behavior: 'smooth' });
          } else {
            window.scrollTo({ top: 0, behavior: 'smooth' });
          }
        }
      });
    });

    // Active section highlight via IntersectionObserver
    const tracked = [
      { id: 'popular', btnId: 'qrBtnPopular' },
      { id: 'new', btnId: 'qrBtnNew' },
      { id: 'jumpBackInRail', btnId: 'qrBtnRecent' },
    ];

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        const item = tracked.find((t) => t.id === entry.target.id);
        if (!item) return;
        const btn = document.getElementById(item.btnId);
        if (!btn) return;
        if (entry.isIntersecting) {
          pill.querySelectorAll('.qr-btn').forEach((b) => b.classList.remove('is-active'));
          btn.classList.add('is-active');
        } else if (btn.classList.contains('is-active')) {
          btn.classList.remove('is-active');
        }
      });
    }, { threshold: 0.3 });

    tracked.forEach((t) => {
      const el = document.getElementById(t.id);
      if (el) observer.observe(el);
    });
  })();
</script>
