---
import { hubs } from '../data/hubs.mjs';
import { u } from '../lib/games.mjs';

const HUB_ICONS: Record<string, string> = {
  'classroom-games': '🎒',
  'math-games': '🧮',
  'puzzle-games-for-school': '🧩',
  'brain-games': '🧠',
  'sports-games': '🏅',
  'unblocked-games-for-chromebook': '💻',
  'games-for-school-breaks': '⚡',
  '2-player-classroom-games': '👥',
};
---

<div
  id="pokiSearchPanel"
  class="poki-search-panel"
  hidden
  role="dialog"
  aria-modal="true"
  aria-label="Search games"
>
  <div class="poki-search-scrim" id="pokiSearchScrim"></div>
  <div class="poki-search-box">
    <div class="poki-search-bar">
      <div class="poki-search-pill">
        <svg class="poki-search-icon" viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
          <path d="M15.5 14h-.79l-.28-.27A6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" />
        </svg>
        <input
          type="search"
          id="pokiSearchInput"
          class="poki-input"
          placeholder="Search games..."
          autocomplete="off"
          aria-label="Search games"
        />
        <button type="button" id="pokiSearchClose" class="poki-close-btn" aria-label="Close search">
          ✕
        </button>
      </div>
    </div>

    <!-- Category cards row (Poki shape) -->
    <div class="poki-cats-scroller" aria-label="Game categories">
      {
        hubs.map((h) => (
          <a href={u(`${h.slug}/`)} class="poki-cat-card">
            <span class="cat-icon">{HUB_ICONS[h.slug] || '🎮'}</span>
            <span class="cat-name">{h.h1.replace(/ Games?/i, '')}</span>
          </a>
        ))
      }
    </div>

    <!-- Results section -->
    <div class="poki-results-wrap">
      <div id="pokiSearchMeta" class="poki-search-meta" aria-live="polite"></div>
      <div id="pokiResultsMosaic" class="tiles"></div>
    </div>
  </div>
</div>

<style>
  .poki-search-panel {
    position: fixed;
    inset: 0;
    z-index: 85;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }
  .poki-search-panel:not([hidden]) {
    display: block;
  }
  .poki-search-panel[hidden] {
    display: none !important;
  }
  .poki-search-scrim {
    position: fixed;
    inset: 0;
    background: rgba(142, 241, 217, 0.95);
    z-index: 1;
    opacity: 0;
    transition: opacity 180ms ease-out;
  }
  .poki-search-panel.is-open .poki-search-scrim {
    opacity: 1;
  }
  .poki-search-box {
    position: relative;
    z-index: 2;
    max-width: 1180px;
    margin: 0 auto;
    padding: 20px 16px 60px;
    opacity: 0;
    transform: translateY(-8px);
    transition: opacity 180ms ease-out, transform 180ms ease-out;
  }
  .poki-search-panel.is-open .poki-search-box {
    opacity: 1;
    transform: translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .poki-search-scrim,
    .poki-search-box {
      transition: none !important;
      transform: none !important;
    }
  }
  .poki-search-bar {
    margin-bottom: 16px;
  }
  .poki-search-pill {
    display: flex;
    align-items: center;
    gap: 12px;
    background: #ffffff;
    border-radius: 999px;
    padding: 8px 18px;
    box-shadow: 0 8px 30px rgba(23, 35, 63, 0.18);
  }
  .poki-search-icon {
    color: #17233f;
    flex: 0 0 auto;
  }
  .poki-input {
    flex: 1 1 auto;
    min-width: 0;
    border: 0;
    background: transparent;
    color: #17233f;
    font-size: clamp(16px, 2.2vw, 20px);
    font-weight: 800;
    font-family: inherit;
    outline: none;
    padding: 6px 0;
  }
  .poki-input::placeholder {
    color: #7b8fae;
    font-weight: 700;
  }
  .poki-close-btn {
    border: 0;
    background: #eef5ff;
    color: #17233f;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    font-size: 16px;
    font-weight: 900;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex: 0 0 auto;
    transition: background 0.15s ease, transform 0.1s ease;
  }
  .poki-close-btn:hover {
    background: #dbeaff;
    transform: scale(1.06);
  }
  .poki-close-btn:active {
    transform: scale(0.92);
  }

  /* Category cards scroller */
  .poki-cats-scroller {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    scrollbar-width: none;
    padding: 6px 0 16px;
    margin-bottom: 14px;
    -webkit-overflow-scrolling: touch;
  }
  .poki-cats-scroller::-webkit-scrollbar {
    display: none;
  }
  .poki-cat-card {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #ffffff;
    color: #17233f;
    padding: 10px 18px;
    border-radius: 14px;
    font-weight: 800;
    font-size: 14px;
    box-shadow: 0 2px 10px rgba(23, 35, 63, 0.12);
    text-decoration: none;
    transition: transform 0.14s ease, box-shadow 0.14s ease;
  }
  .poki-cat-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(23, 35, 63, 0.2);
    text-decoration: none;
    color: #0369a1;
  }
  .poki-cat-card .cat-icon {
    font-size: 17px;
  }

  /* Results section */
  .poki-results-wrap {
    min-height: 200px;
  }
  .poki-search-meta {
    margin-bottom: 12px;
  }
  .poki-count {
    font-size: 14px;
    font-weight: 700;
    color: #1e3a5f;
    margin: 0 0 10px 4px;
  }
  .poki-empty {
    padding: 14px 4px 10px;
  }
  .poki-empty-msg {
    font-size: clamp(16px, 2.2vw, 20px);
    font-weight: 800;
    color: #17233f;
    margin: 0 0 14px;
  }
  .poki-suggestions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 22px;
  }
  .poki-dym-label {
    font-size: 14px;
    font-weight: 700;
    color: #1e3a5f;
  }
  .poki-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .poki-chip {
    background: #ffffff;
    color: #0369a1;
    border: 1.5px solid #0284c7;
    border-radius: 999px;
    padding: 6px 14px;
    font-size: 13.5px;
    font-weight: 800;
    font-family: inherit;
    cursor: pointer;
    box-shadow: 0 2px 6px rgba(23, 35, 63, 0.1);
    transition: background 0.15s ease, color 0.15s ease, transform 0.1s ease;
  }
  .poki-chip:hover {
    background: #0284c7;
    color: #ffffff;
    transform: translateY(-1px);
  }
  .poki-empty-popular-label {
    font-size: 14px;
    font-weight: 800;
    color: #1e3a5f;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 14px 0 12px 2px;
  }
</style>

<script>
  (() => {
    const panel = document.getElementById('pokiSearchPanel');
    const scrim = document.getElementById('pokiSearchScrim');
    const input = document.getElementById('pokiSearchInput') as HTMLInputElement | null;
    const closeBtn = document.getElementById('pokiSearchClose');
    const resultsGrid = document.getElementById('pokiResultsMosaic');
    const metaEl = document.getElementById('pokiSearchMeta');
    const idxEl = document.getElementById('gameIndex');

    if (!panel || !input || !resultsGrid || !metaEl) return;

    let games: Array<{ t: string; u: string; i: string; s: number }> = [];
    try {
      if (idxEl && idxEl.textContent) {
        games = JSON.parse(idxEl.textContent);
      }
    } catch (e) {}

    const esc = (s: string) =>
      s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] || c));

    const levenshtein = (a: string, b: string): number => {
      const m = a.length, n = b.length;
      const d: number[][] = Array.from({ length: m + 1 }, () => new Array(n + 1).fill(0));
      for (let i = 0; i <= m; i++) d[i][0] = i;
      for (let j = 0; j <= n; j++) d[0][j] = j;
      for (let i = 1; i <= m; i++) {
        for (let j = 1; j <= n; j++) {
          const cost = a[i - 1] === b[j - 1] ? 0 : 1;
          d[i][j] = Math.min(d[i - 1][j] + 1, d[i][j - 1] + 1, d[i - 1][j - 1] + cost);
        }
      }
      return d[m][n];
    };

    const scoreSuggestion = (query: string, title: string): number => {
      const q = query.toLowerCase().trim();
      const t = title.toLowerCase().trim();
      if (t === q) return 100;
      if (t.includes(q)) return 80;

      const qTokens = q.split(/\s+/).filter(Boolean);
      const tTokens = t.split(/[\s\-:]+/).filter(Boolean);

      let tokenScore = 0;
      for (const qTok of qTokens) {
        let bestTokDist = 999;
        for (const tTok of tTokens) {
          if (tTok === qTok) { bestTokDist = 0; break; }
          if (tTok.includes(qTok) || qTok.includes(tTok)) {
            bestTokDist = Math.min(bestTokDist, 1);
          } else {
            const d = levenshtein(qTok, tTok);
            if (d < bestTokDist) bestTokDist = d;
          }
        }
        const tokMax = Math.max(qTok.length, 3);
        const sim = Math.max(0, 1 - bestTokDist / tokMax);
        tokenScore += sim;
      }
      const avgTokSim = qTokens.length ? tokenScore / qTokens.length : 0;
      const fullDist = levenshtein(q, t);
      const fullSim = Math.max(0, 1 - fullDist / Math.max(q.length, t.length));
      return avgTokSim * 0.7 + fullSim * 0.3;
    };

    const getSuggestions = (query: string, limit = 3): Array<{ t: string; score: number }> => {
      const scored = games
        .map((g) => ({ t: g.t, score: scoreSuggestion(query, g.t) }))
        .filter((item) => item.score > 0.22)
        .sort((a, b) => b.score - a.score);
      return scored.slice(0, limit);
    };

    const prefersReducedMotion = () =>
      typeof window !== 'undefined' &&
      window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const openPanel = () => {
      panel.hidden = false;
      document.body.style.overflow = 'hidden';
      input.value = '';
      renderResults('');
      if (prefersReducedMotion()) {
        panel.classList.add('is-open');
        input.focus();
      } else {
        requestAnimationFrame(() => {
          panel.classList.add('is-open');
        });
        setTimeout(() => input.focus(), 50);
      }
    };

    const closePanel = () => {
      if (prefersReducedMotion()) {
        panel.classList.remove('is-open');
        panel.hidden = true;
        document.body.style.overflow = '';
        input.value = '';
      } else {
        panel.classList.remove('is-open');
        setTimeout(() => {
          if (!panel.classList.contains('is-open')) {
            panel.hidden = true;
            document.body.style.overflow = '';
            input.value = '';
          }
        }, 180);
      }
    };

    const renderResults = (query: string) => {
      const q = query.trim().toLowerCase();
      if (!q) {
        metaEl.innerHTML = '';
        const topGames = games.slice(0, 24);
        resultsGrid.innerHTML = topGames
          .map((g) => `
            <a class="tile" href="${esc(g.u)}" title="${esc(g.t)}" aria-label="Play ${esc(g.t)} online">
              <img class="tile-img" src="${esc(g.i)}" alt="" loading="lazy" width="512" height="384" />
            </a>
          `)
          .join('');
        return;
      }

      const matched = games
        .filter((g) => g.t.toLowerCase().includes(q))
        .sort((a, b) => {
          const aPrefix = a.t.toLowerCase().startsWith(q) ? 1000 : 0;
          const bPrefix = b.t.toLowerCase().startsWith(q) ? 1000 : 0;
          return (bPrefix + (b.s || 0)) - (aPrefix + (a.s || 0));
        });

      if (matched.length > 0) {
        // N games count line above results
        metaEl.innerHTML = `<div class="poki-count">${matched.length} ${matched.length === 1 ? 'game' : 'games'}</div>`;
        resultsGrid.innerHTML = matched
          .map((g) => `
            <a class="tile" href="${esc(g.u)}" title="${esc(g.t)}" aria-label="Play ${esc(g.t)} online">
              <img class="tile-img" src="${esc(g.i)}" alt="" loading="lazy" width="512" height="384" />
            </a>
          `)
          .join('');
      } else {
        // Zero results empty state with "Did you mean" chips + 6 popular games
        const suggestions = getSuggestions(query, 3);
        metaEl.innerHTML = `
          <div class="poki-empty">
            <p class="poki-empty-msg">No games found for ‘<strong>${esc(query)}</strong>’.</p>
            ${suggestions.length > 0 ? `
              <div class="poki-suggestions">
                <span class="poki-dym-label">Did you mean:</span>
                <div class="poki-chips">
                  ${suggestions.map((s) => `
                    <button type="button" class="poki-chip" data-query="${esc(s.t)}">${esc(s.t)}</button>
                  `).join('')}
                </div>
              </div>
            ` : ''}
            <div class="poki-empty-popular-label">Popular games</div>
          </div>
        `;

        metaEl.querySelectorAll('.poki-chip').forEach((btn) => {
          btn.addEventListener('click', () => {
            const fillQuery = (btn as HTMLElement).dataset.query || '';
            input.value = fillQuery;
            renderResults(fillQuery);
            input.focus();
          });
        });

        // 6 popular games below (existing revenue-first order)
        resultsGrid.innerHTML = games.slice(0, 6)
          .map((g) => `
            <a class="tile" href="${esc(g.u)}" title="${esc(g.t)}" aria-label="Play ${esc(g.t)} online">
              <img class="tile-img" src="${esc(g.i)}" alt="" loading="lazy" width="512" height="384" />
            </a>
          `)
          .join('');
      }
    };

    input.addEventListener('input', () => {
      renderResults(input.value);
    });

    closeBtn?.addEventListener('click', closePanel);
    scrim?.addEventListener('click', closePanel);

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) {
        closePanel();
      }
    });

    (window as any).openPokiSearch = openPanel;
    (window as any).closePokiSearch = closePanel;
    (window as any).togglePokiSearch = () => {
      if (panel.hidden) openPanel();
      else closePanel();
    };

    const headerInput = document.getElementById('siteSearch');
    if (headerInput) {
      headerInput.addEventListener('focus', (e) => {
        e.preventDefault();
        headerInput.blur();
        openPanel();
      });
      headerInput.addEventListener('click', (e) => {
        e.preventDefault();
        openPanel();
      });
    }
  })();
</script>
