---
import { gameUrl } from '../lib/games.mjs';
const { game, big = false, hero = false, eager = false, badge = true, badgeContext = null } = Astro.props;

/* Badges: existing NEW ribbon ONLY on tiles inside this New shelf (pass badge context), nowhere else.
   Keep HOT for featured games. */
const ribbon = badgeContext === 'new' ? 'new' : (badge && game.featured ? 'hot' : null);
---

{/* v10 (Poki system): pure cover art on regular tiles. Zero text noise on
    regular play surfaces. Hero tiles (hub #1) keep the game title + Play chip only.
    The title lives on the link (aria-label + title attr) for accessibility and SEO. */}
<a
  class:list={['tile', { big, 'hero-tile': hero }]}
  href={gameUrl(game)}
  title={game.title}
  aria-label={`Play ${game.title} online`}
>
  <img
    class="tile-img"
    src={game.thumb}
    alt=""
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
    width="512"
    height="384"
  />
  {
    hero ? (
      <>
        <span class="hero-shade" aria-hidden="true" />
        <div class="hero-info">
          <div class="hero-title">{game.title}</div>
          <span class="hero-play-chip" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor">
              <path d="M8 5v14l11-7z" />
            </svg>
            Play
          </span>
        </div>
      </>
    ) : (
      ribbon && (
        <span class:list={['ribbon', ribbon]} aria-hidden="true">
          {ribbon === 'hot' ? (
            <>
              <svg viewBox="0 0 24 24" width="11" height="11" fill="currentColor">
                <path d="M12.6 1.8c.5 3.9-2.2 5.4-3.4 7.2-.8 1.3-.9 2.7.1 3.9.8.9 2.2 1 3.1.2.8-.7.8-1.9.5-3 1.6 1 3.1 2.8 3.1 5a5.6 5.6 0 0 1-11.2 0c0-1.9 1-3.4 2-4.9C7.9 6.9 10.4 3.6 12.6 1.8z" />
              </svg>
              HOT
            </>
          ) : (
            <>
              <svg viewBox="0 0 24 24" width="11" height="11" fill="currentColor">
                <path d="M12 2l2.4 5.6L20 10l-5.6 2.4L12 18l-2.4-5.6L4 10l5.6-2.4L12 2zm7 13l1.2 2.8L23 19l-2.8 1.2L19 23l-1.2-2.8L15 19l2.8-1.2L19 15zm-14 0l1.2 2.8L9 19l-2.8 1.2L5 23l-1.2-2.8L1 19l2.8-1.2L5 15z" />
              </svg>
              NEW
            </>
          )}
        </span>
      )
    )
  }
</a>
