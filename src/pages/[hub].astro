---
import Base from '../layouts/Base.astro';
import GameGrid from '../components/GameGrid.astro';
import { hubs } from '../data/hubs.mjs';
import { shelves, allGames, gameUrl, u } from '../lib/games.mjs';

export function getStaticPaths() {
  return hubs.map((hub) => ({ params: { hub: hub.slug }, props: { hub } }));
}

const HUB_ICONS: Record<string, string> = {
  'classroom-games': '🎒',
  'math-games': '🧮',
  'puzzle-games-for-school': '🧩',
  'brain-games': '🧠',
  'sports-games': '🏅',
  'unblocked-games-for-chromebook': '💻',
  'games-for-school-breaks': '⚡',
  '2-player-classroom-games': '👥',
};

const { hub } = Astro.props;
const games = (shelves[hub.shelf] ? shelves[hub.shelf]() : allGames).slice(0, 48);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: hub.h1,
    description: hub.metaDescription,
    numberOfItems: games.length,
    itemListElement: games.map((g, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: g.title,
      url: g.pageUrl,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'ClassPlay', item: 'https://classplay.online/' },
      { '@type': 'ListItem', position: 2, name: hub.h1, item: `https://classplay.online/${hub.slug}/` },
    ],
  },
];
---

<Base title={hub.metaTitle} description={hub.metaDescription} jsonLd={jsonLd}>
  {/* Above the grid: ONLY shelf-style H1 header per Section 6 */}
  <h1 class="shelf-h1">
    <span class="shelf-icon">{HUB_ICONS[hub.slug] || '🎮'}</span>
    {hub.h1}
  </h1>

  {/* Grid opens with 2x2 hero tile for the #1 game per Deliverable 3 */}
  <GameGrid games={games} hubHero={true} />

  {/* LP1 (Poki): sibling-category cards relocated BELOW grid */}
  <nav class="sib-row" aria-label="More game categories">
    {hubs.filter((h) => h.slug !== hub.slug).map((h) => (
      <a class="sib-card" href={u(`${h.slug}/`)}>{h.h1}</a>
    ))}
  </nav>

  {/* LP1 (Poki): top-picks strip — our own shelf order */}
  <section class="top-picks">
    <h2>Top picks in {hub.h1}</h2>
    <ol>
      {games.slice(0, 5).map((g) => (
        <li><a href={gameUrl(g)}>{g.title}</a></li>
      ))}
    </ol>
  </section>

  {/* Intro copy relocated below grid per Section 6 */}
  <div class="expandable" style="margin-top:26px">
    <div class="prose">
      <p class="hub-tagline"><strong>{hub.tagline || ''}</strong></p>
      <p>{hub.intro[0]}</p>
      <div class="exp-rest">
        <div class="exp-clip">
          {hub.intro.slice(1).map((p) => <p>{p}</p>)}
          <p>
            Every game above was screened for the classroom and runs in a normal browser tab with no
            downloads or sign-ups, on Chromebooks, laptops and phones. Looking for something else? Browse
            the full <a href={import.meta.env.BASE_URL}>ClassPlay</a> catalog from the home page.
          </p>
        </div>
      </div>
    </div>
    <button class="exp-btn" type="button" aria-expanded="false" data-more="Read more ▾" data-less="Show less ▴">Read more ▾</button>
  </div>

  {/* Client-side Jump back in rail (spec §2.1) */}
  <div id="jumpBackInRail"></div>

  <script>
    (() => {
      // Jump back in rail (spec §2.1)
      try {
        const raw = localStorage.getItem('cp-recent');
        const list = raw ? JSON.parse(raw) : [];
        if (!Array.isArray(list) || !list.length) return;
        const container = document.getElementById('jumpBackInRail');
        if (!container) return;
        const esc = (s) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
        const isSparse = list.length <= 2;
        const shelf = document.createElement('section');
        shelf.className = `shelf jump-back-in-shelf${isSparse ? ' is-sparse' : ''}`;
        shelf.innerHTML = `
          <h2>🕒 Jump Back In</h2>
          <div class="tiles rail${isSparse ? ' is-sparse' : ''}">
            ${list.slice(0, 8).map((item) => `
              <a class="tile" href="${esc(item.url)}" title="${esc(item.title)}" aria-label="Play ${esc(item.title)} online">
                <img class="tile-img" src="${esc(item.thumb)}" alt="" loading="lazy" width="512" height="384" />
              </a>
            `).join('')}
          </div>
        `;
        container.appendChild(shelf);
      } catch (e) {}
    })();
  </script>
</Base>
