---
import Base from '../../layouts/Base.astro';
import GameGrid from '../../components/GameGrid.astro';
import { allGames, relatedGames, gameFaqs, gameUrl, u } from '../../lib/games.mjs';
import { artUrl, accentFor } from '../../lib/art.mjs';

export function getStaticPaths() {
  return allGames.map((game) => ({ params: { slug: game.slug }, props: { game } }));
}

const { game } = Astro.props;
const related = relatedGames(game, 6);
const faqs = gameFaqs(game);
const art = artUrl(game);
const accent = accentFor(game);

const title = `Play ${game.title} Online Free — No Download | ClassPlay`;
const description = game.description.slice(0, 158);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'VideoGame',
    name: game.title,
    description: game.description,
    url: game.pageUrl,
    image: game.thumb,
    genre: game.categories,
    gamePlatform: ['Web Browser', 'Chromebook', 'Mobile'],
    applicationCategory: 'Game',
    operatingSystem: 'Any (browser)',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'ClassPlay', item: 'https://classplay.online/' },
      { '@type': 'ListItem', position: 2, name: game.categories[0] || 'Games', item: 'https://classplay.online/classroom-games/' },
      { '@type': 'ListItem', position: 3, name: game.title, item: game.pageUrl },
    ],
  },
];
---

<Base title={title} description={description} canonical={game.pageUrl} ogImage={game.thumb} jsonLd={jsonLd}>
  <div class="crumbs">
    <a href={u()}>Home</a> › <a href={u('classroom-games/')}>Classroom Games</a> › {game.title}
  </div>

  <h1>{game.title}</h1>
  <p class="lede">
    Play {game.title} free in your browser — no download, no sign-up. Works on Chromebooks, laptops and phones.
  </p>

  <div class="stage" style={`--acc:${accent}`}>
    <div class:list={['stage-frame', { 'has-art': !!art }]} style={`aspect-ratio: ${game.width} / ${game.height};`}>
    <div class="player-shell" id="playerShell">
      <button
        class="facade"
        id="playFacade"
        type="button"
        data-embed={game.embedUrl}
        data-title={`Play ${game.title}`}
        aria-label={`Play ${game.title} now`}
      >
        {
          game.thumb ? (
            <img class="facade-poster" src={game.thumb} alt="" aria-hidden="true" width="512" height="384" fetchpriority="high" />
          ) : (
            <span class="facade-fallback" aria-hidden="true">🎮</span>
          )
        }
        <span class="facade-shade" aria-hidden="true"></span>
        <span class="facade-btn" aria-hidden="true">▶</span>
        <span class="facade-cap">
          <b>Play {game.title}</b>
          <small>Free · No download · Starts right in your browser</small>
        </span>
      </button>
      <noscript>
        <iframe
          src={game.embedUrl}
          title={`Play ${game.title}`}
          allow="fullscreen; autoplay; gamepad"
          allowfullscreen
          scrolling="no"
        ></iframe>
      </noscript>
    </div>
    {art && <img class="stage-art" src={art} alt="" aria-hidden="true" width="560" height="560" loading="lazy" />}
    </div>
  </div>
  <div class="player-bar">
    <span class="chips" style="margin-top:0">
      {game.categories.map((c) => <span class="chip">{c}</span>)}
    </span>
    <button class="btn fs-btn" type="button">⛶ Fullscreen</button>
  </div>

  <div class="sticky-play">
    <span class="sp-t">🎮 {game.title}</span>
    <a class="btn ghost" href="#more-like-this" style="padding:9px 14px">More games</a>
    <button class="btn fs-btn" type="button" style="padding:9px 16px">⛶ Play big</button>
  </div>
  <script>
    document.body.classList.add('has-sticky');
    // Click-to-play facade (parity with TabArcade): the third-party player
    // iframe is injected only on a play click, so its scripts and ad stack
    // stay out of the initial load and the poster is what students see first.
    const shell = document.getElementById('playerShell');
    const facade = document.getElementById('playFacade');
    let started = false;
    const startGame = () => {
      if (started || !shell || !facade) return;
      started = true;
      const ifr = document.createElement('iframe');
      ifr.src = facade.dataset.embed;
      ifr.title = facade.dataset.title;
      ifr.allow = 'fullscreen; autoplay; gamepad';
      ifr.allowFullscreen = true;
      ifr.setAttribute('scrolling', 'no');
      facade.replaceWith(ifr);
    };
    facade?.addEventListener('click', startGame);
    const goFs = () => {
      startGame();
      if (shell?.requestFullscreen) shell.requestFullscreen();
      else shell?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    };
    document.querySelectorAll('.fs-btn').forEach((b) => b.addEventListener('click', goFs));
  </script>

  <h2>About {game.title}</h2>
  <div class="prose">
    <p>{game.description}</p>
    {
      game.tags.length > 0 && (
        <p>
          Tags: {game.tags.join(' · ')}
        </p>
      )
    }
  </div>

  <h2>How to Play {game.title}</h2>
  <div class="prose">
    <p>{game.instructions || `Open the game above and follow the on-screen prompts. ${game.title} is designed to be picked up in seconds — most browser games use the arrow keys, WASD, the mouse, or touch controls.`}</p>
    <p>
      Tip: click the Fullscreen button for the biggest play area, especially on a Chromebook.
      If the game seems stuck loading, wait a few seconds and refresh once — browser games stream
      their assets on first load.
    </p>
  </div>

  <h2>{game.title} FAQ</h2>
  <div class="faq">
    {
      faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))
    }
  </div>

  <h2 id="more-like-this">Games Like {game.title}</h2>
  <GameGrid games={related} rail />
</Base>
