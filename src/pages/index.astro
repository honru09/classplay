---
import Base from '../layouts/Base.astro';
import GameGrid from '../components/GameGrid.astro';
import { shelves, gameUrl, u, buildHomeShelves } from '../lib/games.mjs';

const mathPool = shelves.math();
const mathSlugs = new Set(mathPool.map((g) => g.slug));
const puzzlePool = shelves.puzzle().filter((g) => !mathSlugs.has(g.slug));
const puzzleSlugs = new Set(puzzlePool.map((g) => g.slug));
const brainPool = shelves.brain().sort((a, b) => {
  const aDistinct = !puzzleSlugs.has(a.slug) && !mathSlugs.has(a.slug);
  const bDistinct = !puzzleSlugs.has(b.slug) && !mathSlugs.has(b.slug);
  return (bDistinct ? 1 : 0) - (aDistinct ? 1 : 0);
});

const rawHomeShelves = [
  { name: 'featured', pool: shelves.featured(), max: 16 },
  { name: 'classroom', pool: shelves.classroom(), max: 10 },
  { name: 'new', pool: shelves.newGames(), max: 12 },
  { name: 'math', pool: mathPool, max: 10 },
  { name: 'puzzle', pool: puzzlePool, max: 10 },
  { name: 'brain', pool: brainPool, max: 10 },
  { name: 'breaks', pool: shelves.breaks(), max: 10 },
  { name: 'twoPlayer', pool: shelves.twoPlayer(), max: 10 },
  { name: 'sports', pool: shelves.sports(), max: 10 },
];
const dedupedShelves = buildHomeShelves(rawHomeShelves);
const shelfMap = new Map(dedupedShelves.map((s) => [s.name, s.games]));
const featured = shelfMap.get('featured') || [];
const classroom = shelfMap.get('classroom') || [];
const newGames = shelfMap.get('new') || [];
const math = shelfMap.get('math') || [];
const puzzle = shelfMap.get('puzzle') || [];
const brain = shelfMap.get('brain') || [];
const breaks = shelfMap.get('breaks') || [];
const twoPlayer = shelfMap.get('twoPlayer') || [];
const sports = shelfMap.get('sports') || [];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'ClassPlay',
  url: 'https://classplay.online/',
  description:
    'Free classroom games screened for school: math, puzzle and brain games plus gentle arcade and sports titles. They run in a browser tab, so they stay unblocked on school Chromebooks — no downloads, no sign-ups.',
};
---

<Base
  title="Free Classroom Games — Unblocked Games for School | ClassPlay"
  description="Play free classroom games online: math, puzzle, brain and 2 player games screened for school. Unblocked on school Chromebooks — no downloads, no sign-ups, just open a tab and play."
  jsonLd={jsonLd}
>
  <div class="title-strip">
    <h1>Free Classroom Games — Safe, Fun &amp; Ready in Seconds</h1>
    <p class="lede">Math, puzzle and brain games screened for school, plus gentle arcade and sports titles — they run in a browser tab, so they stay unblocked on school Chromebooks. No downloads, no sign-ups.</p>
  </div>

  <section class="shelf" id="popular">
    <h2>🔥 Featured Games</h2>
    <GameGrid games={featured} mosaic />
  </section>

  <section class="shelf">
    <h2>🏫 Classroom Games <a class="more" href={u('classroom-games/')}>all classroom games →</a></h2>
    <GameGrid games={classroom} />
  </section>

  {/* Shelf remainder / more from the shelf */}
  <section class="shelf" id="new">
    <h2>🎮 More from the shelf</h2>
    <GameGrid games={newGames} />
  </section>

  {/* Client-side Jump back in rail (spec §2.1, relocated below popular per A2) */}
  <div id="jumpBackInRail"></div>

  <div class="band band-alt">
    <h2>🧮 Math &amp; Number Games <a class="more" href={u('math-games/')}>all math games →</a></h2>
    <GameGrid games={math} />
  </div>

  <section class="shelf">
    <h2>🧩 Puzzle Games <a class="more" href={u('puzzle-games-for-school/')}>all puzzle games →</a></h2>
    <GameGrid games={puzzle} />
  </section>

  <div class="band band-alt">
    <h2>🧠 Brain Games <a class="more" href={u('brain-games/')}>all brain games →</a></h2>
    <GameGrid games={brain} />
  </div>

  <div class="band band-deep">
    <h2>⚡ Quick Break Games <a class="more" href={u('games-for-school-breaks/')}>games for school breaks →</a></h2>
    <GameGrid games={breaks} />
  </div>

  <section class="shelf">
    <h2>👥 2 Player Games <a class="more" href={u('2-player-classroom-games/')}>2 player classroom games →</a></h2>
    <GameGrid games={twoPlayer} />
  </section>

  <div class="band band-alt">
    <h2>🏅 Sports Games <a class="more" href={u('sports-games/')}>all sports games →</a></h2>
    <GameGrid games={sports} />
  </div>

  {/* Why ClassPlay prose relocated below all shelves per Section 6 */}
  <div class="expandable" style="margin-top:36px">
    <h2>Why ClassPlay?</h2>
    <div class="prose">
      <p class="lede">
        ClassPlay is a shelf of games chosen for school, not just found on the internet. Every title is
        screened to be classroom-appropriate, opens in a normal browser tab, and asks for nothing — no
        downloads, no installs, no accounts. Math, puzzles and brain games lead the shelf, with gentle
        skill games and friendly sports for break time.
      </p>
      <p>
        Most game sites will happily show a ten-year-old anything. ClassPlay is built the other way
        around: we start from what belongs in a classroom and only list games that pass that test. There
        are no shooters here, no horror games, no zombie titles — just puzzles, math and logic games,
        gentle skill games, and sports that two students can share on one keyboard. If a game would make
        a teacher walk over and frown, it does not get in.
      </p>
      <div class="exp-rest">
        <div class="exp-clip">
          <p>
            Everything also has to work the way school actually works. Games load in a plain browser tab on
            the Chromebooks schools hand out, rounds fit inside a break or a reward-time slot, and every game
            page explains the goal and the controls before anyone presses play — so students can start on
            their own, and teachers and parents can see exactly what a game is in ten seconds. Start from
            the <a href={u('classroom-games/')}>classroom games</a> shelf, the
            <a href={u('brain-games/')}>brain games</a>, the
            <a href={u('unblocked-games-for-school/')}>unblocked games for school</a> shelf, or the
            <a href={u('unblocked-games-for-chromebook/')}>Chromebook hub</a>.
          </p>
        </div>
      </div>
    </div>
    <button class="exp-btn" type="button" aria-expanded="false" data-more="Read more ▾" data-less="Show less ▴">Read more ▾</button>
  </div>

  <section class="top-picks">
    <h2>Top picks on ClassPlay</h2>
    <ol>
      {featured.slice(0, 10).map((g) => (
        <li><a href={gameUrl(g)}>{g.title}</a></li>
      ))}
    </ol>
    <p>Every title below opens in a browser tab on Chromebooks, laptops and phones — no download, no sign-up.</p>
  </section>

  <script>
    (() => {
      // Jump back in rail (spec §2.1)
      try {
        const raw = localStorage.getItem('cp-recent');
        const list = raw ? JSON.parse(raw) : [];
        if (!Array.isArray(list) || !list.length) return;
        const container = document.getElementById('jumpBackInRail');
        if (!container) return;
        const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
        const isSparse = list.length <= 2;
        const shelf = document.createElement('section');
        shelf.className = `shelf jump-back-in-shelf${isSparse ? ' is-sparse' : ''}`;
        shelf.innerHTML = `
          <h2>🕒 Jump back in</h2>
          <div class="tiles rail${isSparse ? ' is-sparse' : ''}">
            ${list.slice(0, 8).map((item) => `
              <a class="tile" href="${esc(item.url)}" title="${esc(item.title)}" aria-label="Play ${esc(item.title)} online">
                <img class="tile-img" src="${esc(item.thumb)}" alt="" loading="lazy" width="512" height="384" onload="this.classList.add('is-loaded')" />
              </a>
            `).join('')}
          </div>
        `;
        container.appendChild(shelf);
      } catch (e) {}
    })();
  </script>
</Base>
